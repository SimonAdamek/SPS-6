hostname ALSW1
no ip domain-lookup
!
vlan 10
    name CLIENT_VLAN_25
!
vlan 20
    name CLIENT_VLAN_26
!
vlan 30
    name CLIENT_VLAN_28
!
vlan 40
    name SERVER_VLAN_25
!
vlan 50
    name SERVER_VLAN_26
!
vlan 60
    name SERVER_VLAN_28
!
vlan 14
    name WITCH_MGMT
!
vlan 998
    name UNUSED_PORTS
!
vlan 999
    name NATIVE_VLAN
exit
!
spanning-tree mode mst
!
spanning-tree mst configuration
    name AS6_MST
    revision 1
    instance 1 vlan 10,20,30,14
    instance 2 vlan 40,50,60
exit
!
spanning-tree portfast default
spanning-tree portfast bpduguard default
!
spanning-tree mst 0 priority 61440
spanning-tree mst 1 priority 61440
spanning-tree mst 2 priority 61440
!
interface Loopback 1
    description MANAGEMENT_LOOPBACK

    ipv6 address fdd2:fcc2:bcbc::1/128

    no shutdown
!
interface g0/1
   description TRUNK_DLSW1

    switchport trunk encapsulation dot1q
    switchport mode trunk
    switchport trunk allowed vlan 10-60,999
    switchport trunk native vlan 999

    spanning-tree portfast disable

    no shutdown
!
interface g0/2
   description TRUNK_DLSW2

    switchport trunk encapsulation dot1q
    switchport mode trunk
    switchport trunk allowed vlan 10-60,999
    switchport trunk native vlan 999

    spanning-tree portfast disable

    no shutdown
!
interface g0/3
    description CLIENT

    switchport mode access
    switchport access vlan 10

    no shutdown
!
interface g0/4
    description SERVER

    switchport mode access
    switchport access vlan 40

    no shutdown
!
interface g0/0
 description UNUSED-PORT
 switchport mode access
 switchport access vlan 998
 shutdown
!
end